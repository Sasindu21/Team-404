# Optional: required to enable REAL Gemini AI explanations and chat.
# Get an authorized API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: adds hazard-avoiding routes, subject to provider restrictions.
# https://openrouteservice.org/
ORS_API_KEY=

# Supabase Auth (publishable browser key only; never expose a service-role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
